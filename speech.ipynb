      "execution_count": null,
      "metadata": {
        "id": "5EsHTlM00jZi"
      },
      "outputs": [],
      "source": [
        "def remove_stopwords(text):\n",
        "  doc = nlp(text)\n",
        "  no_stopwords_list = [word.text for word in doc if not word.is_stop]\n",
        "  return ' '.join(no_stopwords_list)\n",
        "\n",
        "df['final_tweet'] = df['lemma_tweet'].apply(remove_stopwords)"
      ]
